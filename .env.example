# Skopiuj do .env i uzupełnij. Plik .env NIE powinien trafiać do repozytorium.

# --- Ogólne ---
APP_SECRET=zmien_mnie_na_losowy_ciag
# Adres, pod którym otwierasz aplikację (linki w powiadomieniach)
APP_PUBLIC_URL=http://localhost:8088
APP_TIMEZONE=Europe/Warsaw
# Interfejs i port hosta. 127.0.0.1 = dostęp tylko z tej maszyny (aplikacja nie ma logowania!)
HTTP_BIND=127.0.0.1
HTTP_PORT=8088

# --- Baza danych ---
POSTGRES_DB=jobhunter
POSTGRES_USER=jobhunter
POSTGRES_PASSWORD=jobhunter

# --- Skanowanie ---
# Co ile godzin skanować portale (po zmianie: docker compose up -d worker)
SCAN_INTERVAL_HOURS=6
# Ile kolejnych nieudanych skanów (błąd lub 0 ogłoszeń) wywołuje alert
SCAN_FAILURE_ALERT_THRESHOLD=3
# Po ilu kolejnych skanach bez danego ogłoszenia oznaczyć je jako wygasłe
EXPIRE_AFTER_MISSED_SCANS=4
# Kulturalne pobieranie: odstęp między zapytaniami do jednego portalu (ms) i limit stron na słowo kluczowe
SCRAPER_DELAY_MS=2000
SCRAPER_MAX_PAGES=5

# --- Powiadomienia (można też ustawić w UI → Ustawienia; wartości z UI mają pierwszeństwo) ---
# Discord: Ustawienia kanału → Integracje → Webhooki → Kopiuj URL webhooka
DISCORD_WEBHOOK_URL=
# Telegram: token od @BotFather oraz ID czatu (np. z https://api.telegram.org/bot<TOKEN>/getUpdates)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
